1033.limit(100)\nfrom pyspark.sql.types import StructType, AtomicType\n\n# Extract schema for S3DataSource_1787706441033\nschema_json_S3DataSource_1787706441033 = S3DataSource_1787706441033.schema.json()\n\n# Filter only flat (primitive) fields from S3DataSource_1787706441033's schema\nflat_fields_S3DataSource_1787706441033 = [f.name for f in S3DataSource_1787706441033.schema.fields if isinstance(f.dataType, AtomicType)][:100]\n\n# Select flat fields and limit to 100 rows\nsample_df_S3DataSource_1787706441033 = S3DataSource_1787706441033.select(*flat_fields_S3DataSource_1787706441033).limit(100)\nsample_rows_S3DataSource_1787706441033 = sample_df_S3DataSource_1787706441033.collect()\n\n# Convert to safe stringified sample preview\nsample_data_S3DataSource_1787706441033 = [\n  {field: str(row[field]) if row[field] is not None else None for field in flat_fields_S3DataSource_1787706441033}\n  for row in sample_rows_S3DataSource_1787706441033\n]\n\n# Combine schema and sample\noutput_S3DataSource_1787706441033 = json.dumps({\n  \"Schema\": json.loads(schema_json_S3DataSource_1787706441033),\n  \"DataSample\": sample_data_S3DataSource_1787706441033\n}, default=str)\n\nprint(output_S3DataSource_1787706441033)"]}]],"createSessionRequest":{"Role":"arn:aws:iam::311141545248:role/AmazonSageMakerAdminIAMExecutionRoleForTesting","Command":{"Name":"glueetl","PythonVersion":"3"},"DefaultArguments":{"--enable-glue-datacatalog":"true","--enable-auto-scaling":"true","--project_s3_path":"s3://amazon-sagemaker-311141545248-eu-west-2-4g6vh2dg7vikut/sys/","--redshift_iam_role":"arn:aws:iam::311141545248:role/AmazonSageMakerAdminIAMExecutionRoleForTesting","--redshift_tempdir":"s3://amazon-sagemaker-311141545248-eu-west-2-4g6vh2dg7vikut/sys/redshift/tmp/","--enable-lakeformation-fine-grained-access":"false","--conf":"spark.sql.extensions=org.apache.iceberg.spark.extensions.IcebergSparkSessionExtensions --conf spark.datasource.redshift.community.glue_endpoint=https://glue.eu-west-2.amazon